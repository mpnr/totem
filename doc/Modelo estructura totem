# 6. Archivo `script.js`

```javascript
let servicios = [];

// Cargar datos desde JSON
fetch("datos.json")
    .then(respuesta => respuesta.json())
    .then(datos => {
        document.getElementById("nombreInstituto").textContent = datos.instituto;
        servicios = datos.servicios;
    })
    .catch(error => {
        console.error("Error al cargar el JSON:", error);
    });

// Mostrar un servicio concreto
function mostrarServicio(idServicio) {
    const servicio = servicios.find(item => item.id === idServicio);

    if (!servicio) {
        document.getElementById("contenidoServicio").innerHTML = `
            <h2>Error</h2>
            <p>No se ha encontrado el servicio solicitado.</p>
        `;
        return;
    }

    let listaFunciones = "";

    servicio.funciones.forEach(funcion => {
        listaFunciones += `<li>${funcion}</li>`;
    });

    document.getElementById("contenidoServicio").innerHTML = `
        <h2>${servicio.icono} ${servicio.nombre}</h2>
        <p>${servicio.descripcion}</p>
        <p class="horario">${servicio.horario}</p>

        <h3>Funciones principales</h3>
        <ul>
            ${listaFunciones}
        </ul>
    `;
}

// Cargar datos desde XML
fetch("datos.xml")
    .then(respuesta => respuesta.text())
    .then(textoXml => {
        const parser = new DOMParser();
        const xml = parser.parseFromString(textoXml, "application/xml");

        const serviciosXml = xml.getElementsByTagName("servicio");
        let contenido = "";

        for (let i = 0; i < serviciosXml.length; i++) {
            const nombre = serviciosXml[i].getElementsByTagName("nombre")[0].textContent;
            const ubicacion = serviciosXml[i].getElementsByTagName("ubicacion")[0].textContent;
            const responsable = serviciosXml[i].getElementsByTagName("responsable")[0].textContent;

            contenido += `
                <div class="bloque-xml">
                    <h3>${nombre}</h3>
                    <p><strong>Ubicación:</strong> ${ubicacion}</p>
                    <p><strong>Responsable:</strong> ${responsable}</p>
                </div>
            `;
        }

        document.getElementById("datosXml").innerHTML = contenido;
    })
    .catch(error => {
        console.error("Error al cargar el XML:", error);
    });
```

